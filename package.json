{
  "name": "ra2-ini-intellisense",
  "displayName": "%extension.displayName%",
  "publisher": "Astralette",
  "description": "%extension.description%",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Super-StarX/INI-IntelliSense.git"
  },
  "private": true,
  "version": "0.0.6",
  "engines": {
    "vscode": "^1.96.0"
  },
  "activationEvents": [],
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ra2",
    "red alert 2",
    "yuri's revenge",
    "ini",
    "intellisense",
    "modding",
    "mix",
    "csf",
    "shp",
    "vxl",
    "hva",
    "westwood"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ra2-ini",
        "aliases": [
          "INI (RA2)",
          "ini"
        ],
        "extensions": [
          ".ini",
          ".map",
          ".mpr",
          ".yrm"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "llf",
        "aliases": [
          "LLF",
          "llf"
        ],
        "extensions": [
          ".llf"
        ]
      }
    ],
    "grammars": [
      {
        "language": "ra2-ini",
        "scopeName": "source.ra2-ini",
        "path": "./syntaxes/ini.tmLanguage.json"
      },
      {
        "language": "llf",
        "scopeName": "source.llf",
        "path": "./syntaxes/llf.tmLanguage.json"
      }
    ],
    "semanticTokenProvider": {
      "id": "iniSemanticProvider",
      "selector": [
        {
          "language": "ra2-ini"
        }
      ],
      "legend": {
        "tokenTypes": [
          "comment",
          "sectionBracket",
          "sectionContent",
          "sectionInherit",
          "keyPart1",
          "keyPart2",
          "keyPart3",
          "operator",
          "value",
          "valueComma",
          "valueString"
        ],
        "tokenModifiers": []
      }
    },
    "customEditors": [
      {
        "viewType": "ra2-resource-preview.viewer",
        "displayName": "%view.resourceWorkbench.name%",
        "selector": [
          {
            "filenamePattern": "*.pcx"
          },
          {
            "filenamePattern": "*.shp"
          },
          {
            "filenamePattern": "*.pal"
          },
          {
            "filenamePattern": "*.vxl"
          },
          {
            "filenamePattern": "*.hva"
          },
          {
            "filenamePattern": "*.wav"
          },
          {
            "filenamePattern": "*.mp3"
          },
          {
            "filenamePattern": "*.ogg"
          },
          {
            "filenamePattern": "*.flac"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "ra2-media-workbench",
          "title": "%view.resourceWorkbench.name%",
          "icon": "assets/icon.svg"
        }
      ],
      "activitybar": [
        {
          "id": "ini-intellisense-explorer",
          "title": "%view.container.title%",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "ra2-media-workbench": [
        {
          "id": "ra2-object-inspector",
          "name": "%view.objectInspector.name%",
          "type": "webview",
          "contextualTitle": "%view.objectInspector.name%"
        }
      ],
      "ini-intellisense-explorer": [
        {
          "id": "ra2-project-workbench",
          "name": "%view.projectWorkbench.name%",
          "icon": "assets/icon.svg"
        },
        {
          "id": "ini-files",
          "name": "%view.iniFiles.name%",
          "icon": "$(files)",
          "visibility": "collapsed"
        },
        {
          "id": "mix-files",
          "name": "%view.mixFiles.name%",
          "icon": "$(archive)",
          "visibility": "collapsed"
        },
        {
          "id": "csf-outline",
          "name": "%view.csfOutline.name%",
          "icon": "$(list-flat)",
          "visibility": "collapsed"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "ra2-ini-intellisense.refreshIniFiles",
          "when": "view == ini-files",
          "group": "navigation"
        },
        {
          "command": "ra2-ini-intellisense.refreshMixFiles",
          "when": "view == mix-files",
          "group": "navigation"
        },
        {
          "command": "ra2-ini-intellisense.refreshCsfOutline",
          "when": "view == csf-outline",
          "group": "navigation"
        },
        {
          "command": "ra2-ini-intellisense.searchObjects",
          "when": "view == ra2-project-workbench",
          "group": "navigation"
        },
        {
          "command": "ra2-ini-intellisense.projectOverview",
          "when": "view == ra2-project-workbench",
          "group": "navigation"
        },
        {
          "command": "ra2-ini-intellisense.refreshProject",
          "when": "view == ra2-project-workbench",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceExtname == .mix",
          "command": "ra2-ini-intellisense.mix.openAsWorkspace",
          "group": "navigation"
        },
        {
          "when": "resourceExtname == .mix",
          "command": "ra2-ini-intellisense.mix.openAsWorkspaceInNewWindow",
          "group": "navigation@2"
        },
        {
          "when": "resourceExtname == .mix",
          "command": "ra2-ini-intellisense.mix.compareWith",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "when": "view == mix-files && viewItem =~ /mixFile|mixEntryMixFile/",
          "command": "ra2-ini-intellisense.mix.openAsWorkspace",
          "group": "navigation"
        },
        {
          "when": "view == mix-files && viewItem =~ /mixFile|mixEntryMixFile/",
          "command": "ra2-ini-intellisense.mix.openAsWorkspaceInNewWindow",
          "group": "navigation@2"
        },
        {
          "when": "view == mix-files && viewItem =~ /mixFile|mixDirectory/",
          "command": "ra2-ini-intellisense.mix.compareWith",
          "group": "navigation@3"
        },
        {
          "when": "view == mix-files && viewItem =~ /mixFile|mixDirectory/",
          "command": "ra2-ini-intellisense.mix.importFiles",
          "group": "2_mix"
        },
        {
          "when": "view == mix-files && viewItem =~ /mixDirectory/",
          "command": "ra2-ini-intellisense.mix.newFolder",
          "group": "2_mix"
        },
        {
          "when": "view == mix-files && viewItem =~ /mixEntryFile|mixEntryMixFile|mixDirectory/",
          "command": "ra2-ini-intellisense.mix.export",
          "group": "2_mix"
        },
        {
          "when": "view == mix-files && viewItem =~ /mixEntryFile|mixEntryMixFile|mixDirectory/",
          "command": "ra2-ini-intellisense.mix.rename",
          "group": "2_mix"
        },
        {
          "when": "view == mix-files && viewItem =~ /mixEntryFile|mixEntryMixFile|mixDirectory/",
          "command": "ra2-ini-intellisense.mix.delete",
          "group": "2_mix"
        },
        {
          "command": "ra2-ini-intellisense.openObjectDefinition",
          "when": "view == ra2-project-workbench && viewItem == ra2-project-object",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "when": "editorLangId == 'ra2-ini'",
          "command": "ra2-ini-intellisense.inspect",
          "group": "navigation"
        },
        {
          "when": "editorTextFocus && editorLangId == 'ra2-ini'",
          "command": "ra2-ini-intellisense.registerSectionContext",
          "group": "1_modification"
        },
        {
          "when": "editorTextFocus && editorLangId == 'ra2-ini'",
          "command": "ra2-ini-intellisense.refactor.extractSuperclass",
          "group": "2_refactor"
        },
        {
          "when": "editorTextFocus && editorLangId == 'ra2-ini'",
          "command": "ra2-ini-intellisense.format.selection",
          "group": "9_format"
        },
        {
          "when": "editorTextFocus && editorLangId == 'ra2-ini'",
          "command": "ra2-ini-intellisense.format.document",
          "group": "9_format"
        },
        {
          "command": "ra2-ini-intellisense.checkCenter",
          "when": "editorLangId == ra2-ini",
          "group": "ra2@10"
        },
        {
          "command": "ra2-ini-intellisense.logicChain",
          "when": "editorLangId == ra2-ini",
          "group": "ra2@11"
        },
        {
          "command": "ra2-ini-intellisense.configureFileCategory",
          "when": "editorLangId == ra2-ini",
          "group": "ra2-project@5"
        }
      ],
      "editor/title": [
        {
          "when": "resourceExtname == '.map' || resourceExtname == '.mpr' || resourceExtname == '.yrm'",
          "command": "ra2-ini-intellisense.previewMap",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "command": "ra2-ini-intellisense.refreshIniFiles",
        "title": "%command.refreshIniFiles.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "ra2-ini-intellisense.refreshMixFiles",
        "title": "%command.refreshMixFiles.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "ra2-ini-intellisense.mix.openAsWorkspace",
        "title": "%command.mix.openAsWorkspace.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.mix.openAsWorkspaceInNewWindow",
        "title": "%command.mix.openAsWorkspaceInNewWindow.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.mix.importFiles",
        "title": "%command.mix.importFiles.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.mix.export",
        "title": "%command.mix.export.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.mix.newFolder",
        "title": "%command.mix.newFolder.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.mix.rename",
        "title": "%command.mix.rename.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.mix.delete",
        "title": "%command.mix.delete.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.mix.saveAll",
        "title": "%command.mix.saveAll.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.mix.compareWith",
        "title": "%command.mix.compareWith.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.compareResources",
        "title": "%command.compareResources.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.showWelcomePage",
        "title": "%command.showWelcomePage.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.manageValidator",
        "title": "%command.manageValidator.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.runValidator",
        "title": "%command.runValidator.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.refreshCsfOutline",
        "title": "%command.refreshCsfOutline.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "ra2-ini-intellisense.showDebugInfo",
        "title": "%command.showDebugInfo.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.configureSchemaPath",
        "title": "%command.configureSchemaPath.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.jumpToOverride",
        "title": "%command.jumpToOverride.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.showMainQuickPick",
        "title": "%command.showMainQuickPick.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.registerSectionContext",
        "title": "%command.registerSectionContext.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.refactor.extractSuperclass",
        "title": "%command.extractSuperclass.title%",
        "category": "%command.category.refactor%"
      },
      {
        "command": "ra2-ini-intellisense.format.selection",
        "title": "%command.formatSelection.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.format.document",
        "title": "%command.formatDocument.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.previewMapToSide",
        "title": "%command.previewMapToSide.title%",
        "category": "%command.category%",
        "icon": "$(open-preview)"
      },
      {
        "command": "ra2-ini-intellisense.inspect",
        "title": "%command.inspect.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.browseAssets",
        "title": "%command.browseAssets.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.auditResources",
        "title": "%command.auditResources.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.browseObjects",
        "title": "%command.browseObjects.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.configureProject",
        "title": "%command.configureProject.title%",
        "category": "%command.category%"
      },
      {
        "command": "ra2-ini-intellisense.previewMap",
        "title": "%command.previewMap.title%",
        "category": "%command.category%",
        "icon": "$(preview)"
      },
      {
        "command": "ra2-ini-intellisense.searchObjects",
        "title": "%command.searchObjects.title%",
        "icon": "$(search)"
      },
      {
        "command": "ra2-ini-intellisense.projectOverview",
        "title": "%command.projectOverview.title%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ra2-ini-intellisense.refreshProject",
        "title": "%command.refreshProject.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "ra2-ini-intellisense.openObjectDefinition",
        "title": "%command.openObjectDefinition.title%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ra2-ini-intellisense.checkCenter",
        "title": "%command.checkCenter.title%",
        "category": "RA2 Mod IntelliSense"
      },
      {
        "command": "ra2-ini-intellisense.logicChain",
        "title": "%command.logicChain.title%",
        "category": "RA2 Mod IntelliSense"
      },
      {
        "command": "ra2-ini-intellisense.downloadDictionary",
        "title": "%command.downloadDictionary.title%",
        "category": "RA2 Mod IntelliSense"
      },
      {
        "command": "ra2-ini-intellisense.configureFileCategory",
        "title": "%command.configureFileCategory%"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "ra2-ini-intellisense.exePath": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "%configuration.properties.exePath.description%",
          "scope": "resource"
        },
        "ra2-ini-intellisense.validationFolderPath": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "%configuration.properties.validationFolderPath.description%",
          "scope": "resource"
        },
        "ra2-ini-intellisense.validationFiles": {
          "type": "object",
          "default": {
            "rules": "rules.ini",
            "art": "art.ini",
            "sound": "sound.ini",
            "eva": "eva.ini"
          },
          "description": "%configuration.properties.validationFiles.description%",
          "scope": "resource",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ra2-ini-intellisense.indexing.fileCategories": {
          "type": "object",
          "default": {
            "rules": [
              "rules*.ini"
            ],
            "art": [
              "art*.ini"
            ],
            "sound": [
              "sound*.ini"
            ],
            "ui": [
              "ui*.ini"
            ],
            "theme": [
              "theme*.ini"
            ],
            "ai": [
              "ai*.ini"
            ]
          },
          "description": "%configuration.properties.indexing.fileCategories.description%",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope": "resource"
        },
        "ra2-ini-intellisense.indexing.excludePatterns": {
          "type": "array",
          "default": [],
          "description": "%configuration.properties.indexing.excludePatterns.description%",
          "items": {
            "type": "string"
          },
          "scope": "resource"
        },
        "ra2-ini-intellisense.dontAskToConfigureValidator": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.properties.dontAskToConfigureValidator.description%"
        },
        "ra2-ini-intellisense.dontAskToConfigureProject": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.properties.dontAskToConfigureProject.description%"
        },
        "ra2-ini-intellisense.schemaFilePath": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "%configuration.properties.schemaFilePath.description%",
          "scope": "resource"
        },
        "ra2-ini-intellisense.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.properties.codeLens.enabled.description%",
          "scope": "resource"
        },
        "ra2-ini-intellisense.decorations.overrideIndicator.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.properties.decorations.overrideIndicator.enabled.description%",
          "scope": "resource"
        },
        "ra2-ini-intellisense.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.properties.diagnostics.enabled.description%",
          "scope": "resource"
        },
        "ra2-ini-intellisense.diagnostics.spaceBeforeEquals": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.properties.diagnostics.spaceBeforeEquals.description%",
          "scope": "resource"
        },
        "ra2-ini-intellisense.diagnostics.spaceAfterEquals": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.properties.diagnostics.spaceAfterEquals.description%",
          "scope": "resource"
        },
        "ra2-ini-intellisense.diagnostics.leadingWhitespace": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.properties.diagnostics.leadingWhitespace.description%",
          "scope": "resource"
        },
        "ra2-ini-intellisense.diagnostics.spacesBeforeComment": {
          "type": [
            "number",
            "null"
          ],
          "default": 1,
          "description": "%configuration.properties.diagnostics.spacesBeforeComment.description%",
          "scope": "resource"
        },
        "ra2-ini-intellisense.diagnostics.spaceAfterComment": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.properties.diagnostics.spaceAfterComment.description%",
          "scope": "resource"
        },
        "ra2-ini-intellisense.diagnostics.severity": {
          "type": "object",
          "default": {},
          "description": "%configuration.properties.diagnostics.severity.description%",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "Error",
              "Warning",
              "Information",
              "Hint",
              "None"
            ]
          },
          "scope": "resource"
        },
        "ra2-ini-intellisense.iniValidator.downloadUrl": {
          "type": "string",
          "default": "https://www.bilibili.com/opus/1022686010171981842",
          "description": "%configuration.properties.iniValidator.downloadUrl.description%",
          "scope": "resource"
        },
        "ra2-ini-intellisense.media.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.media.enabled%",
          "scope": "resource"
        },
        "ra2-ini-intellisense.media.autoReveal": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.media.autoReveal%",
          "scope": "resource"
        },
        "ra2-ini-intellisense.media.excludedDirectories": {
          "type": "array",
          "default": [
            ".tmp",
            ".cache",
            "Tools"
          ],
          "items": {
            "type": "string"
          },
          "description": "%configuration.media.excludedDirectories%",
          "scope": "resource"
        },
        "ra2-ini-intellisense.media.inlineThumbnails": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.media.inlineThumbnails%",
          "scope": "resource"
        },
        "ra2-ini-intellisense.media.hoverEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.media.hoverEnabled%",
          "scope": "resource"
        },
        "ra2-ini-intellisense.media.resourceRoots": {
          "type": "array",
          "default": [],
          "description": "%configuration.media.resourceRoots%",
          "items": {
            "type": "string"
          },
          "scope": "resource"
        },
        "ra2-ini-intellisense.media.archiveOrder": {
          "type": "array",
          "default": [],
          "description": "%configuration.media.archiveOrder%",
          "items": {
            "type": "string"
          },
          "scope": "resource"
        },
        "ra2-ini-intellisense.media.theater": {
          "type": "string",
          "default": "tem",
          "description": "%configuration.media.theater%",
          "scope": "resource"
        },
        "ra2-ini-intellisense.media.semanticRules": {
          "type": "array",
          "default": [],
          "description": "%configuration.media.semanticRules%",
          "items": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "owner": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "valueType": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "object",
                  "animation",
                  "sound",
                  "image",
                  "palette",
                  "sequence",
                  "flh",
                  "lighting"
                ]
              },
              "extension": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "scope": "resource"
        },
        "ra2-ini-intellisense.project.entryPoints": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "%configuration.project.entryPoints%"
        },
        "ra2-ini-intellisense.project.objectColumns": {
          "type": "array",
          "default": [
            "Strength",
            "Cost",
            "Speed",
            "Armor"
          ],
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "description": "%configuration.project.objectColumns%"
        },
        "ra2-ini-intellisense.maps.renderer": {
          "type": "object",
          "default": {},
          "scope": "machine-overridable",
          "description": "%configuration.maps.renderer%",
          "additionalProperties": false,
          "properties": {
            "executable": {
              "type": "string"
            },
            "mixDirectory": {
              "type": "string"
            },
            "modDirectories": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rulesFiles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "artFiles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "extraMixes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "ra2-ini-intellisense.diagnostics.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "%configuration.diagnostics.excludePatterns%"
        },
        "ra2-ini-intellisense.diagnostics.overrides": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "files",
              "severity"
            ],
            "properties": {
              "files": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "enum": [
                    "Error",
                    "Warning",
                    "Information",
                    "Hint",
                    "None"
                  ]
                }
              }
            },
            "additionalProperties": false
          },
          "scope": "resource",
          "description": "%configuration.diagnostics.overrides%"
        },
        "ra2-ini-intellisense.indexing.fileOverrides": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "scope": "resource",
          "description": "%configuration.indexing.fileOverrides%"
        },
        "ra2-ini-intellisense.decorations.booleanPreview.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%configuration.decorations.booleanPreview.enabled%"
        },
        "ra2-ini-intellisense.decorations.csfPreview.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%configuration.decorations.csfPreview.enabled%"
        },
        "ra2-ini-intellisense.decorations.csfPreview.maxLength": {
          "type": "integer",
          "default": 30,
          "minimum": 5,
          "maximum": 500,
          "scope": "resource",
          "description": "%configuration.decorations.csfPreview.maxLength%"
        },
        "ra2-ini-intellisense.project.compatibility": {
          "type": "string",
          "enum": [
            "compatible",
            "vanilla"
          ],
          "default": "compatible",
          "scope": "resource",
          "description": "%configuration.project.compatibility%"
        }
      }
    },
    "configurationDefaults": {
      "files.associations": {
        "*.ini": "ra2-ini",
        "*.map": "ra2-ini",
        "*.mpr": "ra2-ini",
        "*.yrm": "ra2-ini"
      },
      "[ra2-ini]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.definitionLinkOpensInPeek": false
      },
      "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
          "sectionBracket": "#FFD700",
          "sectionContent": "#fffab2",
          "sectionInherit": "#fffab29a",
          "keyPart1": "#50b0ff",
          "keyPart2": "#509cff",
          "keyPart3": "#5079ff",
          "operator": "#ffffff",
          "value": "#82c7ff",
          "valueComma": "#ffd000",
          "valueString": "#a76c00",
          "comment": "#808080"
        }
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "source.llf"
            ],
            "settings": {
              "foreground": "#d4d4d4"
            }
          },
          {
            "scope": [
              "comment.line.llf",
              "punctuation.definition.comment.llf"
            ],
            "settings": {
              "foreground": "#6a9955"
            }
          },
          {
            "scope": [
              "entity.name.label.key.llf"
            ],
            "settings": {
              "foreground": "#569cd6",
              "fontStyle": "bold"
            }
          },
          {
            "scope": [
              "punctuation.separator.key-value.llf"
            ],
            "settings": {
              "foreground": "#d4d4d4"
            }
          },
          {
            "scope": [
              "keyword.operator.multiline.llf"
            ],
            "settings": {
              "foreground": "#c586c0"
            }
          },
          {
            "scope": [
              "string.value.llf",
              "string.multiline.continuation.llf"
            ],
            "settings": {
              "foreground": "#ce9178"
            }
          },
          {
            "scope": [
              "punctuation.whitespace.multiline.llf"
            ],
            "settings": {
              "foreground": "#808080"
            }
          }
        ]
      }
    },
    "viewsWelcome": [
      {
        "view": "ra2-project-workbench",
        "contents": "%view.projectWorkbench.welcome%",
        "when": "workbenchState == empty"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit && tsc -p webview-ui/workbench/tsconfig.json",
    "lint": "eslint src webview-ui/workbench",
    "test": "vscode-test",
    "i18n:extract": "vscode-nls-dev extract --outDir i18n",
    "format:workbench": "prettier --write src/context src/media src/resources/project-resources.ts src/mix/core/encrypted-header.ts src/test/media* src/test/resource-inspection.test.ts src/test/visual-edit.test.ts webview-ui/workbench",
    "test:webview": "node scripts/test-workbench.cjs"
  },
  "devDependencies": {
    "@types/ini": "^4.1.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.16.0",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.2",
    "vscode-nls": "^5.1.2",
    "vscode-nls-dev": "^4.0.4"
  },
  "dependencies": {
    "egoroof-blowfish": "^4.0.3",
    "ini": "^5.0.0"
  }
}
